# systemd user unit for the build dashboard (tools/build-dashboard/README.md).
# Installed by `make dashboard-install` with @REPO@ replaced by the checkout path:
#   ~/.config/systemd/user/ocw-build-dashboard.service
# Starts at login; to start at boot without a login: sudo loginctl enable-linger $USER
[Unit]
Description=Open Cycling World build dashboard (port 8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 @REPO@/tools/build-dashboard/dashboard.py --port 8765
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=10
# The dashboard needs < 400 MB (peak 379 MB on 2026-11-15, when the OOM killer
# stopped it while deb ran out of memory; art/build-history/2026-11-15/incidents.md).
# A cap keeps a leak from taking the machine down; it restarts above.
MemoryHigh=768M
MemoryMax=1G

[Install]
WantedBy=default.target
