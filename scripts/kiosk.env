# The Linux kiosks' settings (scripts/ocw-kiosk.sh reads OCW_KIOSK_*=VALUE
# lines at every kiosk start; scripts/deploy-test.sh installs this file as
# /var/tmp/ocw/kiosk.env). Machine-local changes go into kiosk-local.env next
# to it (kept across deploys, read first, so its values win); a variable set
# in the environment wins over both. This file starts nothing: the kiosk runs
# only when the user starts it (ocw-kiosk.sh install / run).
#
# Join the public game server on Fly.io (spec 11.5 *Join info*, README
# "Kiosk: joining a remote server"): fetch its join info at every start,
# ride its world with its riders; no local ocw-server, no bots. Falls back
# to the local server while it cannot be joined.
OCW_KIOSK_SERVER=remote
OCW_KIOSK_REMOTE=https://ocw-server.fly.dev/join.json
