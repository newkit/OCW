/target
*.png
!assets/**/*.png

# Machine configuration and SSH keys stay local (see config/README.md).
/config/*
!/config/README.md
!/config/*.example.*

# Safety net: never commit private keys anywhere.
id_rsa*
id_ecdsa*
id_ed25519*
*_ed25519
*_rsa
*.pem
*.key
known_hosts

# Archived screenshots and videos of test runs (drive.sh, make smoke/video).
/test-output/

# Downloaded source data (OSM extracts, elevation tiles), see scripts/fetch-pilot.sh.
/data/

# Artwork renders are source assets (icons), not test output.
!artwork/**/*.png
# Agent worktrees.
.claude/worktrees/
# The build history lives on the GitHub release "build-history", not in git.
/artwork/build-history/

# Material library (scripts/fetch-materials.sh; spec §4.6): converted textures, not in git.
/assets/materials/
